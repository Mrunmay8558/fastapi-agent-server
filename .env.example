# Application Settings
APP_NAME=FastAPI Agent Server
DEBUG=False
VERSION=1.0.0

# Database Settings
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=agent_server_db

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-very-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:3001"]

# API Settings
API_V1_PREFIX=/api/v1